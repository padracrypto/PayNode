# =====================================================================
# PayNode — PRODUCTION environment template (paynode.online)
#
# This file is a TEMPLATE: it contains no real values and is safe to commit. Copy the keys into
# Vercel > Project > Settings > Environment Variables (scope: Production). Never commit a
# filled-in copy — .gitignore blocks .env* for that reason.
#
# Validate a filled-in copy locally before pasting into Vercel:
#     cp .env.production.example .env.production   # then fill in values
#     npm run check:env
# The same check runs automatically during every Vercel *production* build and fails the
# deploy if anything below is missing or malformed.
#
# REMINDER: every NEXT_PUBLIC_* value is inlined into the JavaScript bundle at BUILD time and
# visible to every visitor. Changing one requires a redeploy. Never put a secret in one.
# Full explanation of each key: DEPLOYMENT.md
# =====================================================================

# ---------------- Supabase ----------------
# Dashboard > Project Settings > API. https, no path, no trailing slash.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon / publishable key. Public by design; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. The service_role key. Bypasses RLS. Used only by /api/indexer. Mark "Sensitive".
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. The "SIWE secret": the app signs each wallet session as an HS256 JWT with this and
# PostgREST verifies it. Dashboard > Project Settings > API (JWT Keys) > Legacy JWT Secret.
SUPABASE_JWT_SECRET=

# ---------------- Arc chain ----------------
# All of these must describe the SAME network the escrow contract is deployed on.
NEXT_PUBLIC_ARC_CHAIN_ID=
NEXT_PUBLIC_ARC_CHAIN_NAME=
NEXT_PUBLIC_ARC_RPC_URL=https://
# Optional but recommended: second RPC for failover.
NEXT_PUBLIC_ARC_RPC_URL_BACKUP=
# Block explorer base URL, no trailing slash (the app appends /tx/<hash>).
NEXT_PUBLIC_ARC_EXPLORER_URL=https://
# Native-unit decimals. 18 was verified against Arc testnet by `npm run check:arc`.
# Re-run that script against the production RPC before launch.
NEXT_PUBLIC_ARC_DECIMALS=18

# ---------------- Escrow contract ----------------
NEXT_PUBLIC_ESCROW_ADDRESS=0x
# Block the escrow was deployed in. The indexer starts here; without it, it scans from genesis.
NEXT_PUBLIC_ESCROW_DEPLOY_BLOCK=

# ---------------- Wallet connect ----------------
# https://cloud.reown.com — allow-list paynode.online (and www.) in that project's settings.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------- Indexer ----------------
# SECRET, at least 32 characters:   openssl rand -hex 32
INDEXER_SECRET=
# SECRET. Vercel Cron sends this as `Authorization: Bearer <value>`, so it must be IDENTICAL
# to INDEXER_SECRET. Not needed if you trigger the indexer from an external scheduler instead.
CRON_SECRET=

# ---------------- Indexer tuning ----------------
# REQUIRED with the free dRPC endpoint (https://arc.drpc.org): it rejects eth_getLogs windows larger
# than ~100 blocks (measured), so the default of 2000 would fail on every run. Raise it only after
# moving to a paid plan / another provider, and re-measure.
INDEXER_MAX_RANGE=100
# Optional (defaults shown):
# INDEXER_CONFIRMATIONS=5
# INDEXER_MAX_BLOCKS_PER_RUN=20000
# INDEXER_POLL_MS=15000          # standalone daemon (npm run indexer) only

# ---------------- AI dispute resolver ----------------
# SECRET, at least 32 characters:   openssl rand -hex 32
# Gates POST /api/dispute/resolve, which signs rulings that move escrow. Fails closed if
# unset. Accepted as `x-resolver-secret` or `Authorization: Bearer`, so a Vercel Cron entry
# pointed at this route needs CRON_SECRET set to this value (NOT to INDEXER_SECRET — the two
# routes verify different secrets and one cron secret cannot serve both; drive the resolver
# from an external scheduler, or from the indexer, if you need both on Vercel Cron).
RESOLVER_SECRET=

# SECRET. Signs the EIP-712 attestations that settle disputes. Mark "Sensitive".
# Blast radius is the whole escrow balance of every project pinned to this key's epoch, and
# rotation is SLOW: initiateResolverUpdate -> 7-day timelock -> applyResolverUpdate, after
# which the new key governs only projects funded from that moment on. Never NEXT_PUBLIC_.
# The address needs no gas: the contract lets any address relay a signed ruling.
RESOLVER_PRIVATE_KEY=

# The address RESOLVER_PRIVATE_KEY must derive — the one announced in
# ResolverUpdateInitiated. A mismatch becomes a startup error instead of BadAttestation
# reverts discovered by whichever party tried to submit a ruling.
RESOLVER_SIGNER_ADDRESS=

# SECRET. Google Gemini API key for the arbitration call. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown):
# RESOLVER_MODEL=gemini-3.5-flash          # prefer a Pro model once billing is enabled
# RESOLVER_THINKING_LEVEL=high             # minimal|low|medium|high — do not lower to save tokens
# RESOLVER_ATTESTATION_TTL_SECONDS=604800   # 7 days; liveness bound, not a replay guard
# DISPUTE_EVIDENCE_WINDOW_SECONDS=259200    # 72h; how long a PARTY must wait to request a
#                                           # ruling while only one side has filed. Skipped
#                                           # once both have. 0 disables. Gates the
#                                           # party-facing /api/dispute/request-resolution
#                                           # only — /api/dispute/resolve is the operator
#                                           # door and is unaffected.

# Verify all of the above against the chain before go-live, and again the moment
# applyResolverUpdate() lands:   npx tsx --env-file=.env.production scripts/check-resolver.ts
